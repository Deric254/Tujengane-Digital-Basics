# Copy to .env.local for `vercel dev`, and set the SAME names in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values.

# Random string, 32+ characters. Signs session cookies. Generate with:  openssl rand -hex 32
COURSE_COOKIE_SECRET=

# Course passwords (choose NEW ones; the old ones were public in the repo history)
COURSE_PASSWORD_LITERACY=
COURSE_PASSWORD_ANALYST=

# Payment proof emails (the "Pay now" window on the site), sent through your own Gmail.
# Create a Google app password (Google Account -> Security -> 2-Step Verification -> App passwords) and paste it here.
# Without it the Send proof button shows a "not switched on yet" message.
GMAIL_APP_PASSWORD=
# Optional. Defaults: sender dericmarangu@gmail.com, and proofs are emailed to that same address.
GMAIL_USER=
PROOF_TO=

# Optional. Change this value (any text) to cancel ALL temporary access codes and sessions at once.
# COURSE_TEMP_EPOCH=1

# ---- AI Tutor (optional). Keys stay on the server and are never sent to the browser. ----
# Providers are tried in this order; only ones with a key are used. Free first, paid last.
# TUTOR_PROVIDERS=groq,gemini,openrouter,anthropic,openai
# GROQ_API_KEY=            (free tier)
# GEMINI_API_KEY=          (free tier)
# OPENROUTER_API_KEY=      (free models)
# ANTHROPIC_API_KEY=       (paid)
# OPENAI_API_KEY=          (paid)
# Optional: TUTOR_MODEL_GROQ / _GEMINI / _OPENROUTER / _ANTHROPIC / _OPENAI to change a model,
#           TUTOR_RATE_PER_HOUR=20 (per learner), TUTOR_DAILY_CAP=800 (everyone), TUTOR_ENABLED=0 to switch off.
