# Copy to .env.local for `vercel dev`, and set the SAME names in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values.

# Random string, 32+ characters. Signs session cookies. Generate with:  openssl rand -hex 32
COURSE_COOKIE_SECRET=

# Course passwords (choose NEW ones; the old ones were public in the repo history)
COURSE_PASSWORD_LITERACY=
COURSE_PASSWORD_ANALYST=

# Payment proof emails (the "Pay now" window on the site), sent through your own Gmail.
# Create a Google app password (Google Account -> Security -> 2-Step Verification -> App passwords) and paste it here.
# Without it the Send proof button shows a "not switched on yet" message.
GMAIL_APP_PASSWORD=
# Optional. Defaults: sender dericmarangu@gmail.com, and proofs are emailed to that same address.
GMAIL_USER=
PROOF_TO=
