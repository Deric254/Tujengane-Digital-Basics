# Copy to .env.local for `vercel dev`, and set the SAME names in Vercel -> Project -> Settings -> Environment Variables.
# Never commit real values.

# Random string, 32+ characters. Signs session cookies. Generate with:  openssl rand -hex 32
COURSE_COOKIE_SECRET=

# Course passwords (choose NEW ones; the old ones were public in the repo history)
COURSE_PASSWORD_LITERACY=
COURSE_PASSWORD_ANALYST=
